{
	"name": "tienda-online",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:all": "node scripts/dev.js",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check:colors": "node scripts/check-colors.js",
		"check": "npm run lint && npm run check:colors && npm test",
		"pb:download": "node scripts/pb-download.js",
		"pb:serve": "node scripts/pb-serve.js",
		"pb:superuser": "node scripts/pb-superuser.js",
		"permissions:sync": "node --env-file-if-exists=.env scripts/permissions-sync.js",
		"create-staff": "node --env-file-if-exists=.env scripts/create-staff.js",
		"seed:catalog": "node --env-file-if-exists=.env scripts/seed-catalog.js",
		"check:schema": "node --env-file-if-exists=.env scripts/check-schema.js",
		"test:integration": "vitest run --config vitest.integration.config.js",
		"jobs:expire-orders": "node --env-file-if-exists=.env scripts/jobs/expire-orders.js",
		"test:e2e": "vitest run --config vitest.e2e.config.js",
		"jobs:reconcile-payments": "node --env-file-if-exists=.env scripts/jobs/reconcile-payments.js",
		"seed:clip-test": "node --env-file-if-exists=.env scripts/seed-clip-test.js",
		"clip:check": "node --env-file-if-exists=.env scripts/clip-check.js"
	},
	"dependencies": {
		"pocketbase": "^0.28.1",
		"qrcode": "^1.5.4",
		"sanitize-html": "^2.18.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"daisyui": "^5.7.47",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.56.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#core/*": "./src/core/*",
		"#modules/*": "./src/modules/*",
		"#ui/*": "./src/ui/*"
	}
}
