{
	"name": "tienda-online",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:all": "node scripts/dev.js",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check:colors": "node scripts/check-colors.js",
		"check": "pnpm lint && pnpm check:colors && pnpm test",
		"pb:download": "node scripts/pb-download.js",
		"pb:serve": "node scripts/pb-serve.js"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"pocketbase": "^0.28.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"daisyui": "^5.7.47",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#core/*": "./src/core/*",
		"#modules/*": "./src/modules/*",
		"#ui/*": "./src/ui/*"
	}
}
