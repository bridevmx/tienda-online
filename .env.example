# URL interna de PocketBase (solo la usa el servidor de SvelteKit; el navegador nunca habla con PocketBase)
PB_URL=http://127.0.0.1:8090

# Credenciales de superusuario de PocketBase. Solo para tareas del servidor
# (checkout de invitados, webhook de Clip, scripts de sincronizacion).
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Clip: credenciales de la API (docs/CLIP.md). Usa CLIP_API_TOKEN (valor tal cual del header
# Authorization) O el par CLIP_API_KEY + CLIP_API_SECRET (Basic). Las llamadas a Clip se hacen solo desde
# el servidor, y el servidor debe estar en Mexico o EE. UU. (Clip responde 403 desde otras regiones).
# CLIP_API_URL=https://api.payclip.com
# CLIP_API_TOKEN=
# CLIP_API_KEY=
# CLIP_API_SECRET=
# Token secreto de la URL del webhook (?token=); tambien firma las referencias de pago. Largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CLIP_WEBHOOK_TOKEN=

# Version de PocketBase a descargar con `npm run pb:download` (vacio = la ultima)
PB_VERSION=

# Tamano maximo de un formulario con imagenes (adapter-node usa 512K por defecto; las imagenes pueden pesar 5 MB)
# BODY_SIZE_LIMIT=10M

# Produccion detras de un proxy con TLS (adapter-node): de donde sale el protocolo y el host
# PROTOCOL_HEADER=x-forwarded-proto
# IP real del visitante (limite de intentos de acceso): la cabecera que pone tu proxy
# ADDRESS_HEADER=x-forwarded-for
# HOST_HEADER=x-forwarded-host
